dist/
node_modules/
*.tgz
*.tsbuildinfo
coverage/
.DS_Store

# pnpm is the package manager (pinned by `packageManager` in package.json), and
# pnpm-lock.yaml is committed. A lockfile from another package manager is a mistake.
package-lock.json
yarn.lock
.pnpm-store/
pnpm-debug.log*
npm-debug.log*

# Local scratch; eslint.config.mjs skips it for the same reason.
temp/

# Doctor / registry output. Regenerated by `pnpm sdk-doctor` and the debug-graph CLIs;
# the canonical mechanics map lives at the repo root, not here.
docs/mechanics-map/
.wiki-build/

# The raw patch-notes archive fetched from Discord.
#
# A working artifact, not a deliverable: it carries message and author ids, and it is thousands
# of messages of Discord JSON. What ships is the DERIVED dataset generated from it.
data/patch-notes/raw-messages.json

# Local secrets. `.env` holds DISCORD_TOKEN for `pnpm patch-notes:ingest`; only the
# value-free `.env.example` is committed.
.env
.env.*
!.env.example

# Keep private artwork filename indexes out of published source.
src/assets/*.generated.ts

# WASM build artifacts: the Javy compiler is fetched on demand, and the module is built from dist.
wasm/.tools/
wasm/.build/
