{
  "name": "@beardedunicorn/thetowersdk",
  "version": "2.0.0",
  "description": "Game data and save-file reading for The Tower — build your own calculators and tools.",
  "license": "MIT",
  "author": "Mike Herold (https://github.com/BeardedUnicorn)",
  "contributors": [
    "TmRxJD (https://github.com/TmRxJD)"
  ],
  "homepage": "https://beardedunicorn.github.io/TheTowerSDK/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeardedUnicorn/TheTowerSDK.git"
  },
  "bugs": {
    "url": "https://github.com/BeardedUnicorn/TheTowerSDK/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "thetowersdk-mcp": "./mcp/server.mjs"
  },
  "sideEffects": false,
  "keywords": [
    "the-tower",
    "thetower",
    "tower-defense",
    "game-data",
    "save-file",
    "calculator",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && pnpm run knowledge:emit",
    "knowledge:emit": "node scripts/emit-knowledge-graph.mjs",
    "daily-missions:goals": "node scripts/build-daily-mission-goals.mjs",
    "relics:game-table": "node scripts/build-relic-game-table.mjs",
    "labs:categories": "node scripts/build-lab-categories.mjs",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.build.json --noEmit",
    "type-check:examples": "tsc -p tsconfig.examples.json",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:docs": "node scripts/check-readme-links.mjs",
    "wiki:build": "node scripts/build-wiki.mjs",
    "wiki:publish": "node scripts/publish-wiki.mjs",
    "wiki:check": "node scripts/build-wiki.mjs --check",
    "lint:published": "node scripts/audit-published-surface.mjs",
    "lint:specifiers": "node scripts/check-sdk-specifiers.mjs",
    "examples:run": "node scripts/run-examples.mjs",
    "lint:conventions": "node scripts/check-conventions.mjs",
    "lint:boundaries": "node scripts/check-source-boundaries.mjs",
    "lint:organization": "node scripts/check-organization.mjs",
    "map": "node scripts/map-the-repo.mjs",
    "lint:map": "node scripts/map-the-repo.mjs --check",
    "lint:calculators": "node scripts/generate-calculator-specs.mjs --check",
    "calculators:generate": "node scripts/generate-calculator-specs.mjs --write",
    "lint:acronyms": "tsx scripts/check-acronym-expansions.ts",
    "test:schema": "vitest run tests/data/schemas.test.ts tests/data/schemas-cover-what-they-claim.test.ts",
    "verify": "node scripts/verify.mjs",
    "verify:serial": "node scripts/verify.mjs --serial",
    "mcp": "node mcp/server.mjs",
    "glossary": "pnpm run build && node scripts/generate-glossary.mjs",
    "bot:demo": "tsx templates/bot-starter.ts",
    "bot:test": "vitest run src/bot",
    "sheets:test": "vitest run src/sheets",
    "docs:snippets": "node scripts/build-doc-snippets.mjs",
    "docs:seed": "pnpm run docs:snippets && pnpm run wiki:build",
    "docs:check": "node scripts/build-doc-snippets.mjs --check && pnpm run wiki:check && node scripts/check-readme-links.mjs && node scripts/build-patch-notes.mjs --check",
    "patch-notes:ingest": "node scripts/ingest-patch-notes.mjs",
    "patch-notes:build": "node scripts/build-patch-notes.mjs",
    "wasm:build": "node wasm/build.mjs",
    "wasm:check": "node wasm/build.mjs --check",
    "wasm:call": "node wasm/run.mjs",
    "mcpb:build": "node scripts/build-mcpb.mjs",
    "lint:package": "node scripts/audit-package-contents.mjs",
    "epaths:refresh-reference": "node scripts/refresh-effective-paths-reference.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "require": "./dist/data/index.js",
      "default": "./dist/data/index.js"
    },
    "./save": {
      "types": "./dist/save/index.d.ts",
      "require": "./dist/save/index.js",
      "default": "./dist/save/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "require": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./save-decoder": {
      "types": "./dist/save-decoder/index.d.ts",
      "require": "./dist/save-decoder/index.js",
      "default": "./dist/save-decoder/index.js"
    },
    "./formatting": {
      "types": "./dist/formatting/index.d.ts",
      "require": "./dist/formatting/index.js",
      "default": "./dist/formatting/index.js"
    },
    "./builders": {
      "types": "./dist/builders/index.d.ts",
      "require": "./dist/builders/index.js",
      "default": "./dist/builders/index.js"
    },
    "./calculators": {
      "types": "./dist/calculators/index.d.ts",
      "require": "./dist/calculators/index.js",
      "default": "./dist/calculators/index.js"
    },
    "./mechanics": {
      "types": "./dist/mechanics/index.d.ts",
      "require": "./dist/mechanics/index.js",
      "default": "./dist/mechanics/index.js"
    },
    "./wiki": {
      "types": "./dist/wiki/index.d.ts",
      "require": "./dist/wiki/index.js",
      "default": "./dist/wiki/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "require": "./dist/charts/index.js",
      "default": "./dist/charts/index.js"
    },
    "./contributions": {
      "types": "./dist/contributions/index.d.ts",
      "require": "./dist/contributions/index.js",
      "default": "./dist/contributions/index.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge/index.d.ts",
      "require": "./dist/knowledge/index.js",
      "default": "./dist/knowledge/index.js"
    },
    "./knowledge-graph.json": "./dist/knowledge/knowledge-graph.v1.json",
    "./knowledge.schema.json": "./dist/knowledge/knowledge.schema.json",
    "./package.json": "./package.json",
    "./sheets": {
      "types": "./dist/sheets/index.d.ts",
      "require": "./dist/sheets/index.js",
      "default": "./dist/sheets/index.js"
    },
    "./bot": {
      "types": "./dist/bot/index.d.ts",
      "require": "./dist/bot/index.js",
      "default": "./dist/bot/index.js"
    },
    "./assets": {
      "types": "./dist/assets/index.d.ts",
      "require": "./dist/assets/index.js",
      "default": "./dist/assets/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "builders": [
        "dist/builders/index.d.ts"
      ],
      "calculators": [
        "dist/calculators/index.d.ts"
      ],
      "data": [
        "dist/data/index.d.ts"
      ],
      "charts": [
        "dist/charts/index.d.ts"
      ],
      "knowledge": [
        "dist/knowledge/index.d.ts"
      ],
      "save": [
        "dist/save/index.d.ts"
      ],
      "node": [
        "dist/node/index.d.ts"
      ],
      "formatting": [
        "dist/formatting/index.d.ts"
      ],
      "mechanics": [
        "dist/mechanics/index.d.ts"
      ],
      "wiki": [
        "dist/wiki/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ],
      "sheets": [
        "dist/sheets/index.d.ts"
      ],
      "bot": [
        "dist/bot/index.d.ts"
      ],
      "assets": [
        "dist/assets/index.d.ts"
      ],
      "contributions": [
        "dist/contributions/index.d.ts"
      ],
      "save-decoder": [
        "dist/save-decoder/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "mcp",
    "README.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "LICENSE",
    "NOTICE",
    "!mcp/**/*.test.ts",
    "!mcp/**/*.test.mjs"
  ],
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  }
}
